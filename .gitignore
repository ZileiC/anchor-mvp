# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
backend/data/
backend/*.db
*.log

# Flutter
mobile/.dart_tool/
mobile/build/
mobile/dist/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/windows/flutter/ephemeral/
mobile/linux/flutter/ephemeral/
mobile/macos/Flutter/ephemeral/
mobile/android/.gradle/
mobile/android/local.properties

# Local config / secrets
.env
.env.local

# The prebuilt Windows folder that ships in the repo (see README: 下载即用).
# Only its runtime data is ignored - the database it creates on first launch
# holds the API keys and must never be committed.
release/windows/backend/data/
release/windows/data/backend.log

# The keys baked into the shipped backend exe (scripts\build_backend.ps1).
# They must never reach git: the exe gets them, the repository does not.
backend/config/
*.env.private
